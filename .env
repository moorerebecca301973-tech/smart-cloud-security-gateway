# =============================================================================
# Smart Cloud Security Gateway - environment configuration
# Copy this file to ".env" and fill in real values before running.
# =============================================================================

# --- Upstream ("your cloud") -------------------------------------------------
# The real service the gateway protects. ALL traffic that passes the ML check
# is forwarded here unchanged (method, path, query string, body, headers).
# Example: point this at the companion file-storage-service (see its own
# README) to make that the destination behind this gateway.
BACKEND_URL=http://localhost:9000

# Optional: if BACKEND_URL is itself a service that enforces its own shared
# secret (e.g. the file storage service's INTERNAL_SERVICE_TOKEN), set the
# SAME value here - the gateway attaches it as X-Internal-Service-Token on
# every forwarded request. Leave blank if the backend doesn't need this.
BACKEND_INTERNAL_TOKEN=

# --- Admin access -------------------------------------------------------------
# Long random secret used ONLY to call /admin/* endpoints (create API keys,
# manage the blocklist, view alerts). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep this out of source control and rotate it periodically.
ADMIN_BOOTSTRAP_TOKEN=change-me-to-a-long-random-secret

# Origins allowed to call /admin/* from a browser (comma-separated). Needed
# for the React admin portal (see admin_portal/) since it runs on its own
# origin/port and calls this API via fetch. Default covers the portal's
# Vite dev server; add its deployed https origin too once you host it.
ADMIN_PORTAL_ORIGINS=http://localhost:5173

# --- Detection model ------------------------------------------------------
MODEL_DIR=models
ATTACK_THRESHOLD=0.5
# monitor = score + log/alert only, never blocks.
# enforce = actually block + blocklist + alert on requests over the threshold.
# Defaults to enforce - the bundled model was retrained on an L7-native
# feature set and validated against edge cases (see README "Model
# provenance"). Drop to monitor if you'd rather watch attack_probability on
# YOUR real traffic for a while first (recommended for anything business-
# critical) before trusting it to block anything.
ENFORCEMENT_MODE=enforce

# --- Blocking behaviour -----------------------------------------------------
BLOCK_DURATION_SECONDS=3600
AUTO_REVOKE_KEY_AFTER_FLAGS=5
AUTH_FAILURES_BEFORE_BLOCK=20
AUTH_FAILURE_WINDOW_SECONDS=60

# --- Flow feature window ----------------------------------------------------
FLOW_WINDOW_SECONDS=60
FLOW_IDLE_GAP_SECONDS=1.0
FLOW_MAX_EVENTS_PER_IP=500

# --- Deterministic rate limit (always enforced, independent of the ML model
# and of ENFORCEMENT_MODE - the reliable first line of defense) -------------
RATE_LIMIT_ENABLED=true
# Max requests from one IP within FLOW_WINDOW_SECONDS before it's blocked.
RATE_LIMIT_MAX_REQUESTS=300

# --- Client IP resolution ----------------------------------------------------
# Set to true ONLY if the gateway sits behind a trusted load balancer/CDN that
# sets X-Forwarded-For itself (otherwise clients can spoof their own IP and
# dodge blocking).
TRUST_PROXY_HEADERS=false

# --- Storage ------------------------------------------------------------------
DB_PATH=data/gateway.db

# --- Upstream request behaviour ----------------------------------------------
UPSTREAM_TIMEOUT_SECONDS=30
MAX_REQUEST_BODY_BYTES=10485760

# --- Alerting (all optional; alerts are always written to the DB regardless) -
# Slack-compatible incoming webhook, or any URL that accepts a JSON POST.
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
